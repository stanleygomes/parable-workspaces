{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "vscode", "mocha"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".vscode-test", "landpage*", "out"]
}
