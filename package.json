{
  "name": "parable-workspaces",
  "displayName": "Parable Workspaces",
  "description": "The elegant and efficient workspace manager for your projects.",
  "version": "1.7.0",
  "license": "MIT",
  "publisher": "stanleygomes",
  "repository": "https://github.com/stanleygomes/parable-workspaces",
  "engines": {
    "vscode": "^1.85.0",
    "node": "24.x"
  },
  "categories": [
    "Other"
  ],
  "icon": "resources/icons/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "parableWorkspacesContainer",
          "title": "Parable Workspaces",
          "icon": "resources/icons/tab-icon.png"
        }
      ]
    },
    "views": {
      "parableWorkspacesContainer": [
        {
          "type": "webview",
          "id": "workspaceManager.workspacesView",
          "name": "",
          "icon": ""
        }
      ]
    },
    "commands": [
      {
        "command": "workspaceManager.saveProject",
        "title": "Save Current Workspace",
        "category": "Parable",
        "icon": "$(add)"
      },
      {
        "command": "workspaceManager.openBackup",
        "title": "Backup & Sync",
        "category": "Parable",
        "icon": "$(cloud-download)"
      },
      {
        "command": "workspaceManager.refreshWorkspaces",
        "title": "Refresh Workspaces",
        "category": "Parable",
        "icon": "$(refresh)"
      },
      {
        "command": "workspaceManager.listProjects",
        "title": "List/Open Workspaces",
        "category": "Parable",
        "icon": "$(list-unordered)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workspaceManager.openBackup",
          "when": "view == workspaceManager.workspacesView",
          "group": "navigation@1"
        },
        {
          "command": "workspaceManager.refreshWorkspaces",
          "when": "view == workspaceManager.workspacesView",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workspaceManager.listProjects",
        "key": "alt+p",
        "mac": "cmd+opt+p"
      }
    ],
    "configuration": {
      "title": "Parable Workspaces",
      "properties": {
        "workspaceManager.storagePath": {
          "type": "string",
          "default": "",
          "description": "Custom folder path to save workspaces.json. If empty, the default OS-specific shared directory will be used.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "build": "npm run compile",
    "package": "npx @vscode/vsce package"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "eslint": "^9.39.3",
    "prettier": "^3.8.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
