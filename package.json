{
  "name": "parable-workspaces",
  "displayName": "Parable Workspaces",
  "description": "A powerful workspace manager for VS Code. Switch between projects instantly, keep your workspaces organized, and sync your favorite projects across all your devices.",
  "version": "1.0.0",
  "license": "MIT",
  "publisher": "stanleygomes",
  "repository": "https://github.com/stanleygomes/parable-workspaces",
  "engines": {
    "vscode": "^1.85.0",
    "node": "24.x"
  },
  "categories": [
    "Other"
  ],
  "icon": "resources/icons/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "parableWorkspacesContainer",
          "title": "Parable Workspaces",
          "icon": "resources/icons/tab-icon.png"
        }
      ]
    },
    "views": {
      "parableWorkspacesContainer": [
        {
          "type": "webview",
          "id": "workspaceManager.workspacesView",
          "name": "",
          "icon": ""
        }
      ]
    },
    "commands": [
      {
        "command": "workspaceManager.saveProject",
        "title": "Save Current Workspace",
        "category": "Parable",
        "icon": "$(add)"
      },
      {
        "command": "workspaceManager.openBackup",
        "title": "Backup & Sync",
        "category": "Parable",
        "icon": "$(cloud-download)"
      },
      {
        "command": "workspaceManager.refreshWorkspaces",
        "title": "Refresh Workspaces",
        "category": "Parable",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workspaceManager.openBackup",
          "when": "view == workspaceManager.workspacesView",
          "group": "navigation@1"
        },
        {
          "command": "workspaceManager.refreshWorkspaces",
          "when": "view == workspaceManager.workspacesView",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Parable Workspaces",
      "properties": {}
    },
    "quickAccess": [
      {
        "prefix": "p",
        "placeholder": "Search Parable Workspaces...",
        "command": "workspaceManager.listProjects"
      }
    ]
  },
  "scripts": {
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vscode-test"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "date-fns": "^4.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "prettier": "^3.8.3",
    "ts-loader": "^9.5.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1"
  }
}
